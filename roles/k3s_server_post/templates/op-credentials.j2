---
apiVersion: v1
kind: Namespace
metadata:
    name: 1password
---
apiVersion: v1
kind: Secret
metadata:
    name: op-credentials
    namespace: 1password
    labels:
        security: generic
type: Opaque
# Connect chart >= 2.3.0 mounts this key as a file and reads it as JSON, so the
# Secret must hold the raw credentials JSON. `data` takes base64, so encoding
# once here stores the JSON itself. (The old `stringData` + b64encode stored it
# base64 encoded, which only the pre-2.3.0 chart could read.)
data:
    1password-credentials.json: '{{ (onepassword_credentials if onepassword_credentials is string else onepassword_credentials | to_json) | b64encode }}'
